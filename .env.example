# Safe for the browser: use the Supabase project URL and publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Do not put the service-role key in this file or in Vercel unless a trusted
# server-only route explicitly requires it. The weekly Edge Function reads its
# service-role secret from Supabase, not from the browser or Vercel.